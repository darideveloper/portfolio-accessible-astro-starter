---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Image } from 'astro:assets'
import { Pagination } from 'accessible-astro-components'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getBlogPosts } from '../../lib/blog'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getBlogPosts()
  return paginate(posts, { pageSize: 6 })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props as Props
---

<DefaultLayout
  title='Blog - Insights, estrategia y el futuro del software'
  description='Bienvenidos a nuestro espacio de divulgación técnica y estratégica. Aquí compartimos nuestra visión sobre cómo la Inteligencia Artificial, el desarrollo a medida y el SEO pueden transformar empresas reales.'
>
  <PageHeader
    title='Insights, estrategia y el futuro del software'
    subtitle='Bienvenidos a nuestro espacio de divulgación técnica y estratégica. Aquí compartimos nuestra visión sobre cómo la Inteligencia Artificial, el desarrollo a medida y el SEO pueden transformar empresas reales. No escribimos solo para otros desarrolladores; escribimos para <i>dueños de negocios que buscan soluciones claras</i> y resultados medibles en un entorno digital que nunca se detiene.'
    bgType='bordered'
  />

  <section class='my-12'>
    <div class='container'>
      <p class='text-sm'>
        <em>Publicación {page.start + 1} a {page.end + 1} de {page.total} publicaciones en total</em>
      </p>
      <ul class='my-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'>
        {
          page.data.map((post) => (
            <li>
              <article class='group flex h-full flex-col overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-sm transition-all duration-300 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900'>
                <a
                  href={'/blog/' + post.id}
                  class='block'
                >
                  <div class='relative h-48 w-full overflow-hidden'>
                    <Image
                      src={post.data.featuredImage}
                      alt={post.data.title}
                      title={post.data.title}
                      width={800}
                      height={450}
                      class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-110'
                      loading='lazy'
                    />
                  </div>
                </a>
                <div class='flex flex-1 flex-col p-6'>
                  <h2 class='mb-2 text-xl font-semibold'>
                    <a
                      href={'/blog/' + post.id}
                      class='hover:text-brand-primary transition-colors duration-200 hover:underline'
                    >
                      {post.data.title}
                    </a>
                  </h2>
                  <p class='mb-4 flex-1 text-neutral-600 dark:text-neutral-400'>{post.data.description}</p>
                  <footer class='mt-auto text-sm text-neutral-500 dark:text-neutral-400'>
                    Autor: {post.data.author}
                  </footer>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class='mt-12 grid place-content-center'>
            <Pagination
              firstPage={page.url.prev ? '/blog' : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/blog/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel='Paginación del blog'
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>
