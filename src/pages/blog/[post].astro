---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { Heading } from 'accessible-astro-components'
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { getBlogPostsForRoutes } from '../../lib/blog'

export async function getStaticPaths() {
  const posts = await getBlogPostsForRoutes()

  return posts.map((post) => {
    return {
      params: { post: post.id },
      props: { post },
    }
  })
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)

const author = {
  name: post.data.author,
  image: '/logo-dari-dev-team-small.png',
  bio: '',
}

const featuredImage = typeof post.data.featuredImage === 'string' ? post.data.featuredImage : post.data.featuredImage.src
---

<DefaultLayout
  title={post.data.title}
  description={post.data.description}
  url={Astro.url.href}
  type='article'
  publishDate={post.data.publishDate.toISOString()}
  author={post.data.author}
  keywords={post.data.keywords}
  image={featuredImage}
  breadcrumbs={[
    { name: 'Home', item: Astro.site },
    { name: 'Blog', item: `${Astro.site}blog` },
    { name: post.data.title, item: Astro.url.href },
  ]}
>
  <PageHeader
    title={post.data.title}
    subtitle={post.data.description}
    author={author}
    bgType='bordered'
    featuredImage={post.data.featuredImage}
  />
  <section class='my-12'>
    <div class='narrow container'>
      <div class='post-content space-content'>
        <Content />
      </div>
    </div>
  </section>
  <section class='my-12'>
    <div class='narrow space-content container'>
      <Heading level='h2'>Share this post</Heading>
      <p>Like this post? Share it with your friends!</p>
      <SocialShares />
    </div>
  </section>
</DefaultLayout>
