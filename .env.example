# Blog API
# Base URL of the external blog API
API_BASE=https://services.darideveloper.com
# Auth token for the blog API
API_TOKEN=
# When "true", the build fails if the blog API is unreachable
# (default behavior is to warn and continue with local posts only)
API_STRICT_MODE=false

# Site
SITE_URL=https://darideveloper.com
